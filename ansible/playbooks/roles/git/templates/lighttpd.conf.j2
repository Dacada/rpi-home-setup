server.modules = (
    "mod_access",
    "mod_alias",
    "mod_cgi",
    "mod_rewrite"
)

server.document-root = "/usr/share/cgit"
server.bind = "127.0.0.1"
server.port = 8081

server.pid-file = "/run/git-web/lighttpd.pid"
server.errorlog-use-syslog = "enable"

alias.url = (
    "/cgit.css" => "/usr/share/cgit/cgit.css",
    "/cgit.js" => "/usr/share/cgit/cgit.js",
    "/cgit.png" => "/usr/share/cgit/cgit.png",
    "/favicon.ico" => "/usr/share/cgit/favicon.ico",
    "/cgit.cgi" => "/usr/lib/cgit/cgit.cgi"
)

url.rewrite-once = (
    "^/(?!cgit[.](?:css|js|png)$|favicon[.]ico$|cgit[.]cgi(?:/|$))(.*)$" => "/cgit.cgi/$1"
)

cgi.assign = (
    ".cgi" => ""
)
