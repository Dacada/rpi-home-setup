#!/usr/bin/env bash
set -euo pipefail

# Back up data with Restic
/usr/bin/restic backup \
    --exclude-if-present={{ restic_exclude_if_present | quote }} \
    {{ restic.backup_paths | map('quote') | join(' ') }}

# Upload encrypted password database
aws s3 cp \
    {{ recovery.password_database_path | quote }} \
    s3://{{ recovery.bucket }}/database.kdbx \
    --no-progress

# Find the most recently modified Aegis export
aegis_file=$(
    find {{ recovery.aegis_export_pattern | dirname | quote }} \
        -maxdepth 1 -type f \
        -name {{ recovery.aegis_export_pattern | basename | quote }} \
        -printf '%T@ %p\n' |
    sort -nr |
    sed -n '1{s/^[^ ]* //;p;}'
)

if [[ -z "$aegis_file" ]]; then
    echo "No Aegis export found" >&2
    exit 1
fi

# Encrypt Aegis export using the public key
tmpfile=$(mktemp)
trap 'rm -f "$tmpfile"' EXIT

age -r {{ recovery.age_public_key | quote }} \
    -o "$tmpfile" \
    "$aegis_file"

# Upload encrypted Aegis export
aws s3 cp "$tmpfile" \
    s3://{{ recovery.bucket }}/aegis.json.age
