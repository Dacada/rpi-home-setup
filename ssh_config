Host remote-gateway
  HostName ssh.{{ dns.suffix }}
  Port 42420

Host geode-lan geode-wan
  HostName geode.{{ dns.suffix }}

Host haze-lan haze-wan
  HostName haze.{{ dns.suffix }}

Host tonic-lan tonic-wan
  HostName tonic.{{ dns.suffix }}

Host geode-wan haze-wan tonic-wan
  ProxyJump remote-gateway

Host *-lan *-wan remote-gateway
  User dacada
  IdentityFile ~/.ssh/id_ed25519
  CertificateFile ~/.ssh/id_ed25519-cert.pub
  IdentitiesOnly yes
